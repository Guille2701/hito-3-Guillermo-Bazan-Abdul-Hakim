# =================================================================
# 🚀 HITO 3: Configuración de Entorno (.env.example)
# =================================================================
# Este archivo sirve como plantilla. Cópialo a un archivo '.env' 
# y rellena los valores reales para tu despliegue local.
# =================================================================

# 🐘 1. Configuración de PostgreSQL
# -----------------------------------------------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=una_contrasena_segura_aqui
POSTGRES_DB=automatizacion_db
# Puerto interno: 5432

# 🤖 2. Configuración de n8n
# -----------------------------------------------------------------
TIMEZONE=Europe/Madrid
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/
# Nota: n8n usará SQLite internamente por defecto según su docker-compose actual.

# 🧠 3. Configuración de IA y Vectores
# -----------------------------------------------------------------
# Qdrant utiliza los puertos 6333 (HTTP) y 6334 (gRPC) por defecto.
# Ollama utiliza el puerto 11434 por defecto.

# 🌐 4. Otros Ajustes
# -----------------------------------------------------------------
NODE_ENV=production
