# ==========================================
# Configuración del entorno (.env.example)
# ==========================================
# Cópialo y renómbralo a '.env' si deseas usar claves reales.
# NUNCA subas el archivo '.env' al control de versiones (git).

# Configuración de PostgreSQL (y base de datos interna de n8n)
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=una_contrasena_segura_aqui
POSTGRES_DB=automatizacion_db

# Configuración General
TIMEZONE=Europe/Madrid
